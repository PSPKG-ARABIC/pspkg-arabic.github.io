:4:"code";s:7:"english";s:7:"support";a:3:{s:4:"menu";b:1;s:9:"subtitles";b:1;s:6:"dubbed";b:1;}}i:1;a:3:{s:4:"name";s:16:"الفرنسية";s:4:"code";s:6:"french";s:7:"support";a:3:{s:4:"menu";b:1;s:9:"subtitles";b:1;s:6:"dubbed";b:1;}}}}i:8;a:32:{s:2:"id";i:48;s:5:"title";s:25:"Uncharted Drake's Fortune";s:8:"platform";s:3:"ps3";s:5:"genre";a:3:{i:0;s:6:"action";i:1;s:9:"adventure";i:2;s:7:"stealth";}s:4:"size";s:7:"17.3 GB";s:5:"image";s:59:"https://i.postimg.cc/02Zb2rhK/Uncharted-Drake-s-Fortune.jpg";s:11:"sliderImage";s:63:"https://i.postimg.cc/zXpVX34g/Uncharted-Drake-s-Fortune-ps3.jpg";s:11:"headerImage";s:63:"https://i.postimg.cc/zXpVX34g/Uncharted-Drake-s-Fortune-ps3.jpg";s:13:"systemVersion";s:9:"3.55/4.92";s:7:"version";s:4:"1.10";s:8:"gameCode";s:36:"BCUS98103 – USA /NPEA00363 – EUR";s:5:"story";s:835:"تدور أحداث اللعبة حول المغامر ناثان كريك (Nathan Drake)، المَنسب – وفق اللعبة – إلى المستكشف السير فرانسيس دريك، والذي ينطلق في رحلة بحث عن الكنز المفقود "إل دورادو" على جزيرة غامضة، بمساعدة الصحفية إلينا فيشر ومرشده فيكتور سوليفان. على مدى القصة، يواجه أعداء، مخلّفات أثرية خطيرة وتمثالاً غامضاً، ويكتشف أن ما بدا كبحث عن المال سرعان ما يتحول إلى صراع من أجل البقاء. اللعبة عُرِفت بأسلوبها السينمائي، البيئة الضخمة، والتقنيات التي حطّمت توقعات الجيل عند إصدارها."";s:9:"developer";s:11:"Naughty Dog";s:9:"publisher";s:30:"Sony Interactive Entertainment";s:11:"releaseDate";s:20:"19 نوفمبر 2007";s:6:"rating";i:9;s:8:"password";s:6:"4GAMER";s:11:"downloadUrl";s:123:"http://zeus.dl.playstation.net/cdn/EP9000/NPEA00363_00/TABHGwegeIyywslMvtNYEpehxeTFqMtfHiuDoXKDXZiglwJxzIyHiYjttWcaKLuA.pkg";s:14:"hasDownloadUrl";b:1;s:9:"languages";a:2:{i:0;a:3:{s:4:"name";s:20:"الإنجليزية";s:4:"code";s:7:"english";s:7:"support";a:3:{s:4:"menu";b:1;s:9:"subtitles";b:1;s:6:"dubbed";b:1;}}i:1;a:3:{s:4:"name";s:16:"الفرنسية";s:4:"code";s:6:"french";s:7:"support";a:3:{s:4:"menu";b:1;s:9:"subtitles";b:1;s:6:"dubbed";b:1;}}}s:9:"hasUpdate";b:1;s:13:"hasUpdate-fix";b:0;s:6:"hasDLC";b:0;s:7:"hasDL