 ضد مخلوقات الأساطير وتواجه الفوريّات في مغامرة تتوسّط بين الانتقام والبقاء."";s:9:"developer";s:25:" SCE Santa Monica Studio ";s:9:"publisher";s:30:"Sony Interactive Entertainment";s:11:"releaseDate";s:16:"12 مارس 2013";s:6:"rating";d:8.7;s:8:"password";s:6:"4GAMER";s:11:"downloadUrl";s:156:"https://sto.romsfast.com/PS3-DEC/God%20of%20War%20-%20Ascension%20(Europe%20Australia)%20(EnFrDeEsItNlPtPlRuElTr).zip?token=cHRbalhpRlBGEW9wXzhQZ15TQxNxfF10";s:9:"hasUpdate";b:0;s:13:"hasUpdate-fix";b:0;s:6:"hasDLC";b:0;s:7:"hasDLC2";b:0;s:14:"hasUpdateParts";b:0;s:11:"hasDLCParts";b:0;s:16:"hasDownloadParts";b:0;s:9:"languages";a:2:{i:0;a:3:{s:4:"name";s:20:"الإنجليزية";s:4:"code";s:7:"english";s:7:"support";a:3:{s:4:"menu";b:1;s:9:"subtitles";b:1;s:6:"dubbed";b:1;}}i:1;a:3:{s:4:"name";s:16:"الفرنسية";s:4:"code";s:6:"french";s:7:"support";a:3:{s:4:"menu";b:1;s:9:"subtitles";b:1;s:6:"dubbed";b:1;}}}}i:12;a:26:{s:2:"id";i:52;s:5:"title";s:14:"God of War III";s:8:"platform";s:3:"ps3";s:5:"genre";a:3:{i:0;s:6:"action";i:1;s:9:"adventure";i:2;s:14:"hack-and-slash";}s:4:"size";s:7:"34.68GB";s:5:"image";s:46:"https://i.postimg.cc/rmH4fsC9/god-of-war-3.jpg";s:11:"sliderImage";s:50:"https://i.postimg.cc/9Mk9L0tb/god-of-war-3-PS3.jpg";s:11:"headerImage";s:50:"https://i.postimg.cc/9Mk9L0tb/god-of-war-3-PS3.jpg";s:13:"systemVersion";s:9:"3.55-4.92";s:7:"version";s:4:"2.00";s:8:"gameCode";s:3:"ISO";s:5:"story";s:442:"في God of War III، يخوض بطلك كراتوس معركة خالدة ضد آلهة الأوليمبوس في معركة نهائية ملحمية، حيث يجمع بين الضراوة والتصميم السينمائي لتحقيق انتقامه وإنهاء حقبة الأساطير. اللعبة معروفة بحجمها الكبير على مستوى الإخراج والمعارك ضد الآلهة التي لا تُنسى."";s:9:"developer";s:24:" SCE Santa Monica Studio";s:9:"publisher";s:27:"Sony Computer Entertainment";s:11:"releaseDate";s:16:"16 مارس 2010";s:6:"rating";i:9;s:8:"password";s:6:"4GAMER";s:11:"downloadUrl";s:115:"https://sto.romsfast.com/PS3-DEC/God%20of%20War%20III%20(USA)%20(v02.00).zip?token=cHRbalhpRlBGEW9wXzhQZ15TQxNwc152";s:9:"ha