a:5:{i:0;a:25:{s:2:"id";i:35;s:5:"title";s:18:" Alone in the Dark";s:8:"platform";s:3:"ps5";s:5:"genre";a:4:{i:0;s:6:"action";i:1;s:6:"horror";i:2;s:8:"survival";i:3;s:6:"arabic";}s:4:"size";s:5:" 28GB";s:5:"image";s:55:"https://i.postimg.cc/ZKhT013Y/Alone-in-the-Dark-PS5.jpg";s:11:"sliderImage";s:55:"https://i.postimg.cc/jdrsCGN5/Alone-in-the-Dark-PS5.jpg";s:11:"headerImage";s:55:"https://i.postimg.cc/jdrsCGN5/Alone-in-the-Dark-PS5.jpg";s:13:"systemVersion";s:13:"6.xx.10----xx";s:7:"version";s:4:"1.01";s:8:"gameCode";s:17:"PPSA08240 – USA";s:5:"story";s:861:"Alone in the Dark هي إعادة إحياء لأحد أوائل ألعاب الرعب في التاريخ، تقدم تجربة تجمع بين الرعب النفسي والأجواء الغامضة في قصر جنوبي مهيب خلال عشرينيات القرن الماضي. تتبع القصة المحقق إدوارد كارني والمرأة الغامضة إميلي هارتوود، اللذين يسافران إلى قصر 'Derceto' المليء بالأسرار والمخلوقات الغريبة للتحقيق في اختفاء عمها. اللعبة تدمج بين عناصر الاستكشاف وحل الألغاز والقتال التكتيكي بأسلوب سينمائي مكثف، مع تركيز قوي على السرد والجو النفسي القاتم المستوحى من أعمال إدغار آلان بو وLovecraft."";s:9:"developer";s:17:"Krisalis Software";s:9:"publisher";s:17:"Krisalis Software";s:11:"releaseDate";s:4:"2024";s:6:"rating";d:8.5;s:8:"password";s:6:"4GAMER";s:11:"downloadUrl";s:38:"https://akirabox.com/k0embxE0WzVb/file";s:9:"hasUpdate";b:0;s:13:"hasUpdate-fix";b:0;s:6:"hasDLC";b:0;s:14:"hasUpdateParts";b:0;s:11:"hasDLCParts";b:0;s:16:"hasDownloadParts";b:0;s:9:"languages";a:2:{i:0;a:3:{s:4:"name";s:14:"العربية";s:4:"code";s:6:"arabic";s:7:"support";a:3:{s:4:"menu";b:1;s:9:"subtitles";b:1;s:6:"dubbed";b:0;}}i:1;a:3:{s:4:"name";s:20:"الإنجليزية";s:4:"code";s:7:"english";s:7:"support";a:3:{s:4:"menu";b:1;s:9:"subtitles";b:1;s:6:"dubbed";b:1;}}}}i:1;a:32:{s:2:"id";i:62;s:5:"title";s:5:"FC 26";s:8:"platform";s:3:"ps4";s:5:"genre";a:2:{i:0;s:6:"sports";i:1;s:10:"simulation";}s:4:"size";s:4:"75GB";s:5:"image";s:41:"https://i.postimg.cc/vZnYySsZ/fc6-PS4.jpg";s:11:"sliderImage";s:42:"https://i.postimg.cc/HsF2197k/FC26-PS5.jpg";s:11:"hea