a:32:{i:0;a:27:{s:2:"id";i:2;s:5:"title";s:20:"God of War Ragnarök";s:8:"platform";s:3:"ps4";s:5:"genre";a:4:{i:0;s:6:"action";i:1;s:9:"adventure";i:2;s:14:"hack-and-slash";i:3;s:6:"arabic";}s:4:"size";s:6:"100 GB";s:5:"image";s:86:"https://i.postimg.cc/G2jh9xTM/God-of-War-Ragnar-k-Launch-Edition-Playstation-4-jpg.jpg";s:11:"sliderImage";s:53:"https://ps4-gamer-arabe.zya.me/images/gowragnarok.jpg";s:11:"headerImage";s:53:"https://ps4-gamer-arabe.zya.me/images/gowragnarok.jpg";s:13:"systemVersion";s:10:"5.05/11.00";s:7:"version";s:4:"5.05";s:8:"gameCode";s:9:"CUSA34390";s:5:"story";s:422:"God of War Ragnarök هي خاتمة ملحمة كرايوس وأتريوس في عالم الأساطير الإسكندنافية. انطلق في رحلة ملحمية عبر العوالم التسعة واجه الآلهة الوحشية والوحوش الأسطورية في معركة الفجار. اللعبة تقدم قصة مؤثرة، قتال استراتيجي، وعوالم شاسعة للاستكشاف.";s:9:"developer";s:19:"Santa Monica Studio";s:9:"publisher";s:30:"Sony Interactive Entertainment";s:11:"releaseDate";s:19:"9 نوفمبر 2022";s:6:"rating";d:9.7;s:8:"password";s:6:"4GAMER";s:11:"downloadUrl";s:56:"https://akirabox.com/2bJG8BKq3OBE/file#4GAMER/T.ME/C9_91";s:9:"hasUpdate";b:1;s:13:"hasUpdate-fix";b:0;s:6:"hasDLC";b:0;s:14:"hasUpdateParts";b:0;s:11:"hasDLCParts";b:0;s:16:"hasDownloadParts";b:0;s:9:"languages";a:1:{i:0;a:3:{s:4:"name";s:14:"العربية";s:4:"code";s:6:"arabic";s:7:"support";a:3:{s:4:"menu";b:1;s:9:"subtitles";b:1;s:6:"dubbed";b:1;}}}s:10:"updateSize";s:5:"24 GB";s:9:"updateUrl";s:56:"https://akirabox.com/qPez47pN3OYn/file#4GAMER/T.ME/C9_91";}i:1;a:27:{s:2:"id";i:5;s:5:"title";s:22:"Horizon Forbidden West";s:8:"platform";s:3:"ps4";s:5:"genre";a:3:{i:0;s:6:"action";i:1;s:9:"adventure";i:2;s:6:"arabic";}s:4:"size";s:5:"98 GB";s:5:"image";s:56:"https://i.postimg.cc/jSJf2Bx8/Horizon-Forbidden-West.jpg";s:11:"sliderImage";s:65:"https://i.postimg.cc/13NFXbmd/horizon-forbidden-west-complete.jpg";s:11:"headerImage";s:65:"https://i.postimg.cc/13NFXbmd/horizon-forbidden-west-complete.jpg";s:13:"systemVersion";s:10:"5.05/11.00";s:7:"versi