s://i.postimg.cc/g2ywmjqm/in-FAMOUS-PS3.jpg";s:11:"headerImage";s:47:"https://i.postimg.cc/g2ywmjqm/in-FAMOUS-PS3.jpg";s:13:"systemVersion";s:9:"3.55/4.92";s:7:"version";s:4:"2.00";s:8:"gameCode";s:10:" NPEA00252";s:5:"story";s:538:"داخل مدينة إف إمباير سيتي الخيالية، يُحطم انفجار ضخم ستة مربّعات ويمنح راسِل دراجة اسمه كول مكغراث قوى كهربائية مذهلة. الآن يقف أمام خيارين: أن يصبح بطلاً ينقذ المظلومين، أو أن يستغل قدراته لترويع المدينة والسيطرة عليها. في هذا العالم المفتوح، كلّ قرار تتخذه له تأثير على الناس والحوار والمآلات."";s:9:"developer";s:12:"Sucker Punch";s:9:"publisher";s:27:"Sony Computer Entertainment";s:11:"releaseDate";s:16:"26 مايو 2009";s:6:"rating";d:8.5;s:8:"password";s:6:"4GAMER";s:11:"downloadUrl";s:115:"https://sto1.romsforever.co/0:/PS3-PSN/inFamous%20(Europe)%20(NPEA00252).zip?token=cHRbalhpRlBGEW9wXzhQZ15TQhZ4fFx0";s:9:"hasUpdate";b:0;s:13:"hasUpdate-fix";b:0;s:6:"hasDLC";b:0;s:7:"hasDLC2";b:0;s:14:"hasUpdateParts";b:0;s:11:"hasDLCParts";b:0;s:16:"hasDownloadParts";b:0;s:9:"languages";a:2:{i:0;a:3:{s:4:"name";s:20:"الإنجليزية";s:4:"code";s:7:"english";s:7:"support";a:3:{s:4:"menu";b:1;s:9:"subtitles";b:1;s:6:"dubbed";b:1;}}i:1;a:3:{s:4:"name";s:16:"الفرنسية";s:4:"code";s:6:"french";s:7:"support";a:3:{s:4:"menu";b:1;s:9:"subtitles";b:1;s:6:"dubbed";b:0;}}}}i:65;a:26:{s:2:"id";i:47;s:5:"title";s:10:"inFAMOUS 2";s:8:"platform";s:3:"ps3";s:5:"genre";a:3:{i:0;s:6:"action";i:1;s:9:"adventure";i:2;s:10:"open-world";}s:4:"size";s:7:"14.05GB";s:5:"image";s:45:"https://i.postimg.cc/wMSSf67J/in-FAMOUS-2.jpg";s:11:"sliderImage";s:49:"https://i.postimg.cc/GtZZ7cHG/in-FAMOUS-2-PS3.jpg";s:11:"headerImage";s:49:"https://i.postimg.cc/GtZZ7cHG/in-FAMOUS-2-PS3.jpg";s:13:"systemVersion";s:9:"3.55/4.92";s:7:"version";s:4:"1.00";s:8:"gameCode";s:3:"PSN";s:5:"story";s:426:"بعد أحداث الجزء الأول، يتوجّه كول مكغراث إلى مدينة نيو ماريس لمواجهة أكثر تهديدات القوى الكهربية خطورة واللقاء بأعدائه القديمين والجدد. الاختيارات الأخلاقية بين الخير والشر تؤثر بشكل جوهري في مجريات القصة والقدرات التي يكتسبها كول."";s:9:"developer";s:12:"Sucker Punch";s:9:"publisher";s:27:"Sony Computer Entertainment";s:11:"releaseDate";s:17:"7 يونيو 2011";s:6:"rating";d:8.5;s:8:"password";s:6:"4GAMER";s:11:"downloadUrl";s:105:"https://sto1.romsforever.co/0:/PS3-PSN/inFamous%202%20(Europe).zip?token=cHRbalhpRlBGEW9wXzhQZ15TQhlzdFpz";s:9:"hasUpdate";b:0;s:13:"hasUpdate-fix";b:0;s:6:"hasDLC";b:0;s:7:"hasDLC2";b:0;s:14:"hasUpdateParts";b:0;s:11:"hasDLCParts";b:0;s:16:"hasDownloadParts";b:0;s:9:"languages";a:2:{i:0;a:3:{s:4:"name";s:20:"الإنجليزية";s:4:"code";s:7:"english";s:7:"support";a:3:{s:4:"menu";b:1;s:9:"subtitles";b:1;s:6:"dubbed";b:1;}}i:1;a:3:{s:4:"name";s:16:"الفرنسية";s:4:"code";s:6:"french";s:7:"support";a:3:{s:4:"menu";b:1;s:9:"subtitles";b:1;s:6:"dubbed";b:1;}}}}i:66;a:32:{s:2:"id";i:48;s:5:"title";s:25:"Uncharted Drake's Fortune";s:8:"platform";s:3:"ps3";s:5:"genre";a:3:{i:0;s:6:"action";i:1;s:9:"adventure";i:2;s:7:"stealth";}s:4:"size";s:7:"17.3 GB";s:5:"image";s:59:"https://i.postimg.cc/02Zb2rhK/Uncharted-Drake-s-Fortune.jpg";s:11:"sliderImage";s:63:"https://i.postimg.cc/zXpVX34g/Uncharted-Drake-s-Fortune-ps3.jpg";s:11:"headerImage";s:63:"https://i.postimg.cc/zXpVX34g/Uncharted-Drake-s-Fortune-ps3.jpg";s:13:"systemVersion";s:9:"3.55/4.92";s:7:"version";s:4:"1.10";s:8:"gameCode";s:36:"BCUS98103 – USA /NPEA00363 – EUR";s:5:"story";s:835:"تدور أحداث اللعبة حول المغامر ناثان كريك (Nathan Drake)، المَنسب – وفق اللعبة – إلى المستكشف السير فرانسيس دريك، والذي ينطلق في رحلة بحث عن الكنز المفقود "إل دورادو" على جزيرة غامضة، بمساعدة الصحفية إلينا فيشر ومرشده فيكتور سوليفان. على مدى القصة، يواجه أعداء، مخلّفات أثرية خطيرة وتمثالاً غامضاً، ويكتشف أن ما بدا كبحث عن المال سرعان ما يتحول إلى صراع من أجل البقاء. اللعبة عُرِفت بأسلوبها السينمائي، البيئة الضخمة، والتقنيات التي حطّمت توقعات الجيل عند إصدارها."";s:9:"developer";s:11:"Naughty Dog";s:9:"publisher";s:30:"Sony Interactive Entertainment";s:11:"releaseDate";s:20:"19 نوفمبر 2007";s:6:"rating";i:9;s:8:"password";s:6:"4GAMER";s:11:"downloadUrl";s:123:"http://zeus.dl.playstation.net/cdn/EP9000/NPEA00363_00/TABHGwegeIyywslMvtNYEpehxeTFqMtfHiuDoXKDXZiglwJxzIyHiYjttWcaKLuA.pkg";s:14:"hasDownloadUrl";b:1;s:9:"languages";a:2:{i:0;a:3:{s:4:"name";s:20:"الإنجليزية";s:4:"code";s:7:"english";s:7:"support";a:3:{s:4:"menu";b:1;s:9:"subtitles";b:1;s:6:"dubbed";b:1;}}i:1;a:3:{s:4:"name";s:16:"الفرنسية";s:4:"code";s:6:"french";s:7:"support";a:3:{s:4:"menu";b:1;s:9:"subtitles";b:1;s:6:"dubbed";b:1;}}}s:9:"hasUpdate";b:1;s:13:"hasUpdate-fix";b:0;s:6:"hasDLC";b:0;s:7:"hasDLC2";b:0;s:14:"hasUpdateParts";b:0;s:11:"hasDLCParts";b:0;s:16:"hasDownloadParts";b:1;s:10:"updateSize";s:3:"RAP";s:9:"updateUrl";s:109:"https://nopaystation.com/tools/rap2file/EP9000-NPEA00363_00-UNCHARTED1PCKG01/316EA07ED0930DFC20D0EA9ECCDD8E0D";s:11:"updateParts";a:0:{}s:8:"dlcParts";a:0:{}s:13:"downloadParts";a:1:{i:0;a:3:{s:4:"name";s:21:"(Game + Update v1.10)";s:4:"size";s:5:"21GB+";s:3:"url";s:118:"https://archive.org/download/uncharted-drakes-fortune-bcus-98103/Uncharted%20Drake%27s%20Fortune%20%5BBCUS98103%5D.iso";}}}i:67;a:30:{s:2:"id";i:49;s:5:"title";s:35:"Uncharted 3: Drake's Deception-GOTY";s:8:"platform";s:3:"ps3";s:5:"genre";a:3:{i:0;s:6:"action";i:1;s:9:"adventure";i:2;s:7:"stealth";}s:4:"size";s:4:"45GB";s:5:"image";s:72:"https://i.postimg.cc/q7m74FFw/Uncharted-3-Drake-s-Deception-GOTY-PS3.jpg";s:11:"sliderImage";s:68:"https://i.postimg.cc/5tPtbrrn/Uncharted-3-Drake-s-Deception-GOTY.jpg";s:11:"headerImage";s:68:"https://i.postimg.cc/5tPtbrrn/Uncharted-3-Drake-s-Deception-GOTY.jpg";s:13:"systemVersion";s:9:"3.55/4.92";s:7:"version";s:4:"1.00";s:8:"gameCode";s:23:"BCES01670 – EUR - ISO";s:5:"story";s:521:"في Uncharted 3: Drake's Deception، ينطلق ناثان دريك ومرشده فيكتور سوليفان في رحلة ملحمية إلى قلب صحراء الربخي (Rub' al Khali) بحثاً عن المدينة الأسطورية "إيرام الأعمدة"، لكن الأمور تنقلب إلى سباق للبقاء والكشف عن مؤامرة سرّية قديمة. اللعبة تقدم مزيجاً من الأكشن السينمائي، التسلل الخفي، والمغامرات الكبرى."
