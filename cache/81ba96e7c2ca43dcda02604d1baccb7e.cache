a:26:{i:0;a:25:{s:2:"id";i:21;s:5:"title";s:22:"Resident evil 2 Remake";s:8:"platform";s:3:"ps5";s:5:"genre";a:4:{i:0;s:6:"action";i:1;s:6:"horror";i:2;s:8:"survival";i:3;s:6:"arabic";}s:4:"size";s:43:"19GB جميع الاضافات مفتوحة";s:5:"image";s:45:"https://i.postimg.cc/wvDc62Wx/RESIV2REPS5.jpg";s:11:"sliderImage";s:47:"https://i.postimg.cc/pTKY2C0T/residentevil2.jpg";s:11:"headerImage";s:47:"https://i.postimg.cc/pTKY2C0T/residentevil2.jpg";s:13:"systemVersion";s:13:"3.xx.10----xx";s:7:"version";s:5:"1.003";s:8:"gameCode";s:17:"PPSA04288 – USA";s:5:"story";s:665:"Resident Evil 2 Remake على PS5 تعيد إحياء الكلاسيكية الأسطورية بأسلوب حديث ومذهل. تدور الأحداث في مدينة راكون سيتي التي اجتاحها فيروس قاتل حول سكانها إلى زومبي. يتحكم اللاعب في ليون كينيدي وكلير ريدفيلد، اللذين يحاولان النجاة وكشف أسرار شركة أمبريلا الشريرة. النسخة المحسّنة على PS5 تقدم رسومات واقعية، إضاءة مذهلة، وأداء فائق يجعل تجربة الرعب أكثر غموضًا وتوتراً من أي وقت مضى.";s:9:"developer";s:6:"Capcom";s:9:"publisher";s:6:"Capcom";s:11:"releaseDate";s:4:"2022";s:6:"rating";i:8;s:8:"password";s:6:"4GAMER";s:11:"downloadUrl";s:38:"https://akirabox.com/qLQ36pl1KG19/file";s:9:"hasUpdate";b:0;s:13:"hasUpdate-fix";b:0;s:6:"hasDLC";b:0;s:14:"hasUpdateParts";b:0;s:11:"hasDLCParts";b:0;s:16:"hasDownloadParts";b:0;s:9:"languages";a:1:{i:0;a:3:{s:4:"name";s:14:"العربية";s:4:"code";s:6:"arabic";s:7:"support";a:3:{s:4:"menu";b:1;s:9:"subtitles";b:1;s:6:"dubbed";b:0;}}}}i:1;a:25:{s:2:"id";i:22;s:5:"title";s:22:"Resident evil 3 Remake";s:8:"platform";s:3:"ps5";s:5:"genre";a:4:{i:0;s:6:"action";i:1;s:6:"horror";i:2;s:8:"survival";i:3;s:6:"arabic";}s:4:"size";s:43:"18GB جميع الاضافات مفتوحة";s:5:"image";s:45:"https://i.postimg.cc/9QXgFDqc/resv3ps5rem.jpg";s:11:"sliderImage";s:47:"https://i.postimg.cc/W1pYbdJN/residentevil3.jpg";s:11:"headerImage";s:47:"https://i.postimg.cc/W1pYbdJN/residentevil3.jpg";s:13:"systemVersion";s:13:"3.xx.10----xx";s:7:"version";s:5:"1.004";s:8:"gameCode";s:17:"PPSA03952 – USA";s:5:"story";s:694:"Resident Evil 3 Remake تعيد تقديم واحدة من أكثر قصص الرعب الكلاسيكية في تاريخ الألعاب بأسلوب سينمائي مذهل. تدور الأحداث في مدينة راكون سيتي المنهارة، حيث تحاول جيل فالنتاين النجاة من الكابوس وهي مطاردة من قبل المخلوق القاتل نيميسيس. تجمع اللعبة بين الأكشن والبقاء والرعب النفسي، مع تجربة مطورة بالكامل على محرك RE Engine الذي يمنحها تفاصيل واقعية وإضاءة مذهلة تجعل كل لحظة مليئة بالتوتر والخطر."";s:9:"developer";s:6:"Capcom";s:9:"publisher";s:6:"Capcom";s:11:"releaseDate";s:4:"2022";s:6:"rating";d:8.3;s:8:"password";s:6:"4GAMER";s:11:"downloadUrl";s:38:"https://akirabox.com/N2p3DJjJRGMa/file";s:9:"hasUpdate";b:0;s:13:"hasUpdate-fix";b:0;s:6:"hasDLC";b:0;s:14:"hasUpdateParts";b:0;s:11:"hasDLCParts";b:0;s:16:"hasDownloadParts";b:0;s:9:"languages";a:1:{i:0;a:3:{s:4:"name";s:14:"العربية";s:4:"code";s:6:"arabic";s:7:"support";a:3:{s:4:"menu";b:1;s:9:"subtitles";b:1;s:6:"dubbed";b:0;}}}}i:2;a:25:{s:2:"id";i:23;s:5:"title";s:21:"Resident Evil Village";s:8:"platform";s:3:"ps5";s:5:"genre";a:5:{i:0;s:6:"action";i:1;s:7:"shooter";i:2;s:6:"horror";i:3;s:8:"survival";i:4;s:6:"arabic";}s:4:"size";s:44:"24GB  جميع الاضافات مفتوحة";s:5:"image";s:43:"https://i.postimg.cc/C1zSLGQ0/resv8vps5.jpg";s:11:"sliderImage";s:55:"https://i.postimg.cc/3JyvSw2k/resident-evil-village.jpg";s:11:"headerImage";s:55:"https://i.postimg.cc/3JyvSw2k/resident-evil-village.jpg";s:13:"systemVersion";s:13:"3.xx.10----xx";s:7:"version";s:5:"1.001";s:8:"gameCode";s:17:"PPSA01556 – USA";s:5:"story";s:679:"Resident Evil Village تواصل قصة إيثان وينترز بعد أحداث الجزء السابع، حيث يجد نفسه في قرية أوروبية نائية تعج بالكائنات الغامضة والمخلوقات المتحولة. بعد اختطاف ابنته الطفلة، ينطلق إيثان في رحلة مروعة عبر القرية لمواجهة قوى مظلمة وأسرار غامضة يقودها زعماء مرعبون مثل ليدي ديميتريسكو. اللعبة تمزج بين الرعب الكلاسيكي والأكشن المكثف بأسلوب سينمائي وتجربة بصرية مذهلة على الجيل الجديد."
